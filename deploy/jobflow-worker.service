[Unit]
Description=Synapse background worker
After=network.target mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/jobflow
ExecStart=/usr/bin/php /var/www/jobflow/scripts/worker.php
Restart=always
RestartSec=5
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/jobflow/storage
UMask=0077

[Install]
WantedBy=multi-user.target
