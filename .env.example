APP_NAME=Synapse
APP_ENV=production
DOCUMENT_STORAGE=gcs
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-private-document-bucket
GCS_OBJECT_PREFIX=documents
# Extra active browser origins to preserve when applying the bucket CORS rule.
GCS_CORS_ORIGINS=
# Unfavorited application attachments move here three days after confirmed submission.
GCS_COLD_STORAGE_CLASS=COLDLINE
APP_URL=https://jobflow.mystuffs.co.ke
APP_KEY=generate-with-php-scripts-key.php
APP_TIMEZONE=Africa/Nairobi
SESSION_SECURE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobflow
DB_USERNAME=jobflow
DB_PASSWORD=
DB_SOCKET=
# Deployment settings. This tracked example contains no real credentials.
# Actions reads its own secrets/variables; it does not load this file or .env.
DB_DEPLOY_BASE_URL=https://jobflow.mystuffs.co.ke
# Copy the existing GitHub DB_DEPLOY_SECRET into private .env and hosting .env.
# It must be the same 64-character lowercase hex value in all three places.
DB_DEPLOY_SECRET=
# Confirm the provider's backup schedule before enabling later schema changes.
DB_DEPLOY_BACKUP_POLICY=hosting-daily
# Actual backup time in UTC, for example 01:00 only if confirmed by hosting.
DB_DEPLOY_BACKUP_UTC=
DB_DEPLOY_BACKUP_MAX_AGE_HOURS=4
# FTP_SERVER, FTP_USERNAME and FTP_PASSWORD are GitHub Actions secrets.
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
# Exact FTP-visible web root, starting and ending with /. Verify after login.
# Use / only when the FTP account is confined to this site's public_html.
# Hosting filesystem root: /home/themude3/domains/jobflow.mystuffs.co.ke/public_html/
FTP_SERVER_DIR=
FTP_PROTOCOL=ftps
FTP_PORT=21

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: absolute path to downloaded Web application OAuth JSON, or inline JSON.
# GOOGLE_OAUTH_JSON=/absolute/private/path/client_secret_example.json
# GOOGLE_OAUTH_JSON='{"web":{"client_id":"...","client_secret":"..."}}'
GOOGLE_OAUTH_JSON=
# Gmail and sign-in can share this registered callback.
GOOGLE_REDIRECT_URI=https://jobflow.mystuffs.co.ke/Callback
# Strong matches requiring a manual application are emailed to each account's own email.
# Set SMTP_USERNAME to the sender email and SMTP_PASSWORD to its app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME. Gmail requires your sender or a configured alias.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Synapse
UPLOAD_MAX_MB=10
# Keep 0600 when PHP and the worker share a user. A private group/ACL can use 0640.
PRIVATE_FILE_MODE=0600
# Stateless document renderer, deployed separately to Cloud Run. Keep the shared token private.
DOCUMENT_RENDERER_URL=
DOCUMENT_RENDERER_TOKEN=
JOBFLOW_TEST_DATABASE=jobflow_test
NODE_BINARY=node
CHROMIUM_PATH=
FUZU_BROWSER_HEADLESS=false

# Use the same callback as Gmail; permissions remain separate.
GOOGLE_SIGNIN_REDIRECT_URI=https://jobflow.mystuffs.co.ke/Callback

# Built-in Gemini for paid accounts. Keys are never sent to browsers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_INPUT_PER_MILLION=0.25
GEMINI_OUTPUT_PER_MILLION=1.50

# M-Pesa Daraja Express (Paybill or Buy Goods STK Push).
# Sandbox payments are accepted only outside APP_ENV=production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://jobflow.mystuffs.co.ke/api/billing/mpesa/callback
# Hard per-user monthly cap for the shared provider, enforced server-side.
SITE_AI_MONTHLY_BUDGET_USD=1
